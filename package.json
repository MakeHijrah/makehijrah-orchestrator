{
  "name": "makehijrah-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Private backend orchestrator for MakeHijrah Relocation OS",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@supabase/supabase-js": "^2.57.4",
