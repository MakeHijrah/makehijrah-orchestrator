    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.7.0",
    "luxon": "^3.7.2",
    "stripe": "^22.3.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
